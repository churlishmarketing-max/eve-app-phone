# Build-time config for the phone client.
#
# ONE VARIABLE. VITE_BRAIN_TOKEN IS GONE AND MUST NOT COME BACK — it compiled
# the live brain bearer token into the JS bundle as a plaintext literal, which
# made the built APK a credential anyone holding the file could read. The token
# is now pasted once on the phone and kept on the device (src/tokenStore.ts);
# nothing in src/ reads it from the environment.

# Where the brain lives. Dev: localhost. APK on your phone: the hosted brain
# URL, or your PC's LAN IP (e.g. http://192.168.1.20:8787) over Wi-Fi.
# Not a secret: it answers 401 to anyone without the token.
VITE_BRAIN_URL=http://localhost:8787
